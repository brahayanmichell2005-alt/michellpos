# Copia este archivo como .env.local y completa los valores.
# Obtengo las claves en: Supabase → Configuración del proyecto → API

# URL de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública (anon) — puede usarse en el navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA

# Clave service_role — SOLO servidor. NUNCA exponer en el navegador.
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE

# Clave que usan los crones de Vercel (Authorization: Bearer ...)
CRON_SECRET=UNA_CLAVE_LARGA_ALEATORIA

# Cifra (AES-256) las credenciales SOL de los clientes en /app/sunat
SUNAT_SECRET=OTRA_CLAVE_LARGA_ALEATORIA

# Correos automáticos (Resend, plan gratis). Sin API key: los avisos
# quedan registrados en registro_sistema y no se envía nada.
RESEND_API_KEY=
RESEND_FROM=michellpos <onboarding@resend.dev>
